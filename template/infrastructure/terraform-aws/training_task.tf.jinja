resource "aws_security_group" "training_task" {
  name        = "${local.name_prefix}-training-task"
  description = "Training tasks with outbound HTTPS and no inbound access"
  vpc_id      = aws_vpc.main.id
}

# Development topology: public IPs provide outbound HTTPS access to AWS
# service endpoints. No inbound access is permitted.
# Use private subnets and controlled endpoints for stricter isolation.
# trivy:ignore:AVD-AWS-0104
resource "aws_vpc_security_group_egress_rule" "training_task_https" {
  security_group_id = aws_security_group.training_task.id
  description       = "Outbound HTTPS for training inputs and results"
  cidr_ipv4         = "0.0.0.0/0"

  ip_protocol = "tcp"
  from_port   = 443
  to_port     = 443
}

resource "aws_ecs_task_definition" "training" {
  count = var.training_task_enabled ? 1 : 0

  family                   = "${local.name_prefix}-training"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "2048"
  memory                   = "8192"

  execution_role_arn = aws_iam_role.training_execution.arn
  task_role_arn      = aws_iam_role.training_task.arn

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = "X86_64"
  }

  container_definitions = jsonencode([
    {
      name      = "training"
      essential = true
      image     = "${aws_ecr_repository.training.repository_url}@${var.training_image_digest}"

      user             = "10001:10001"
      workingDirectory = "/app"

      entryPoint = [
        "python",
        "-m",
        "{{ package_name }}.aws.fargate_train"
      ]

      command = [
        "--input-uri",
        "s3://${aws_s3_bucket.artifacts.id}/training/input",
        "--output-uri",
        "s3://${aws_s3_bucket.artifacts.id}/training/output",
        "--config",
        "configs/dev.yaml",
        "--timeout-seconds",
        "900"
      ]

      mountPoints    = []
      portMappings   = []
      systemControls = []
      volumesFrom    = []

      linuxParameters = {
        capabilities = {
          add  = []
          drop = ["ALL"]
        }
      }

      environment = [
        {
          name  = "AWS_REGION"
          value = var.aws_region
        },
        {
          name  = "AWS_DEFAULT_REGION"
          value = var.aws_region
        },
        {
          name  = "CLOUD_PROVIDER"
          value = "local"
        },
        {
          name  = "MLFLOW_DISABLE_TELEMETRY"
          value = "true"
        }
      ]

      logConfiguration = {
        logDriver = "awslogs"
        options = {
          awslogs-group         = aws_cloudwatch_log_group.training.name
          awslogs-region        = var.aws_region
          awslogs-stream-prefix = "training"
        }
      }
    }
  ])

  lifecycle {
    precondition {
      condition     = var.training_image_digest != ""
      error_message = "Set training_image_digest before enabling the training task."
    }
  }

  depends_on = [
    aws_iam_role_policy.training_execution,
    aws_iam_role_policy.training_task,
    aws_s3_bucket_server_side_encryption_configuration.artifacts,
    aws_s3_bucket_policy.artifacts
  ]
}