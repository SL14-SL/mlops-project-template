from prefect import flow

from ..configs.loader import load_config
from ..pipeline.project_factory import (
    build_project_training_pipeline,
)
from ..pipeline.runner import TrackedPipelineResult
from .prefect_adapter import (
    run_prefect_training_pipeline,
)


@flow(
    name="{{ project_slug }}-training",
    validate_parameters=False,
    persist_result=False,
)
def training_flow(
    run_id: str | None = None,
) -> TrackedPipelineResult:
    """Run the configured {{ task_type }} training pipeline."""
    config = load_config()
    pipeline = build_project_training_pipeline(
        config
    )

    return run_prefect_training_pipeline(
        pipeline=pipeline,
        run_id=run_id,
    )


if __name__ == "__main__":
    training_flow()