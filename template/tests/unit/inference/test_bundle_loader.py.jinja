def test_build_serving_bundle_without_extra_artifacts() -> None:
    model = MagicMock()
    loader = MagicMock(return_value=model)
    result = bundle_loader.build_serving_bundle(
        manifest=build_manifest(), release_root="/release",
        serving_alias="champion", model_loader=loader,
    )
    assert result.model is model
    assert result.artifact_uris == {}
    loader.assert_called_once_with("models:/forecasting-model@champion")


def test_build_serving_bundle_resolves_arbitrary_project_artifact(monkeypatch) -> None:
    from dataclasses import replace

    manifest = replace(
        build_manifest(), artifacts={"sensor_calibration": artifact("calibration.json")},
    )
    resolver = MagicMock(return_value="/release/calibration.json")
    monkeypatch.setattr(bundle_loader, "resolve_artifact_uri", resolver)
    result = bundle_loader.build_serving_bundle(
        manifest=manifest, release_root="/release",
        serving_alias="champion", model_loader=MagicMock(),
    )
    assert result.artifact_uris == {"sensor_calibration": "/release/calibration.json"}
    resolver.assert_called_once_with(
        release_root="/release", reference=manifest.artifacts["sensor_calibration"],
    )
