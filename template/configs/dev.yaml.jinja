project:
  name: "{{ project_name }}"
  slug: "{{ project_slug }}"
  task_type: "{{ task_type }}"
  tier: "{{ project_tier }}"

{% if project_tier == "end_to_end" %}
notifications:
  enabled: true
  log_events: true
  fail_on_error: false
  webhook:
    enabled: false
    url: "${LIFECYCLE_WEBHOOK_URL:-}"
    timeout_seconds: 5.0
{% endif %}
paths:
  data_root: "data"
  raw: "data/raw"
  interim: "data/interim"
  processed: "data/processed"
  artifacts: "artifacts"
  models: "artifacts/models"

{% if project_tier == "end_to_end" %}
services:
  prefect_api_url: "${PREFECT_API_URL:-http://localhost:4200/api}"
{% endif %}
serving: 
  alias: "champion"

api:
  api_key: "${API_KEY:-dev-api-key-change-me}"
  
tracking:
  mlflow_tracking_uri: "${MLFLOW_TRACKING_URI:-http://localhost:5000}"
  experiment_name: "{{ project_slug }}-dev"
  model_name: "{{ project_slug }}-model-dev"
{% if project_tier == "end_to_end" %}
  promotion:
{% if task_type == "classification" %}
    metric_name: accuracy
    direction: maximize
    minimum_improvement: 0.01
{% elif task_type == "forecasting" %}
    metric_name: rmse
    direction: minimize
    minimum_improvement: 0.0
{% endif %}
    allow_initial_champion: true
{% endif %}
