project:
  name: "{{ project_name }}"
  slug: "{{ project_slug }}"
  task_type: "{{ task_type }}"

notifications:
  enabled: true
  log_events: true
  fail_on_error: false
  webhook:
    enabled: false
    url: "${LIFECYCLE_WEBHOOK_URL:-}"
    timeout_seconds: 5.0
    
paths:
  data_root: "gs://${GCS_BUCKET_NAME:-replace-me}/data"
  raw: "gs://${GCS_BUCKET_NAME:-replace-me}/data/raw"
  interim: "gs://${GCS_BUCKET_NAME:-replace-me}/data/interim"
  processed: "gs://${GCS_BUCKET_NAME:-replace-me}/data/processed"
  artifacts: "gs://${GCS_BUCKET_NAME:-replace-me}/artifacts"
  models: "gs://${GCS_BUCKET_NAME:-replace-me}/models"

serving:
  alias: "champion"
  
services:
  prefect_api_url: "${PREFECT_API_URL}"

api:
  api_key: "${API_KEY}"

tracking:
  mlflow_tracking_uri: "${MLFLOW_TRACKING_URI}"
  experiment_name: "{{ project_slug }}-staging"
  model_name: "{{ project_slug }}-model-staging"
  promotion:
{% if task_type == "classification" %}
    metric_name: accuracy
    direction: maximize
    minimum_improvement: 0.01
{% elif task_type == "forecasting" %}
    metric_name: rmse
    direction: minimize
    minimum_improvement: 0.0
{% endif %}
    allow_initial_champion: true